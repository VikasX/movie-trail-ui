{
  "name": "cinescope",
  "private": true,
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "types:generate": "openapi-typescript docs/openapi.yaml -o src/types/api.generated.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@reduxjs/toolkit": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.74.0",
    "msw": "^2.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/routing-utils": "^6.6.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
