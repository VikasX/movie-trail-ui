# Default demo mode. Switch to live when Django product endpoints are ready.
VITE_API_MODE=mock
# VITE_API_MODE=live

# Browser requests use this same-origin prefix in local and deployed environments.
VITE_API_BASE_URL=/api/v1/

# Local UI origin. Leave blank to use the current browser origin.
VITE_APP_URL=
# VITE_APP_URL=http://localhost:5173
# VITE_APP_URL=https://movie-trail-ui.vercel.app

# Vite development proxy target (server-side configuration).
API_PROXY_TARGET=http://localhost:8000
# API_PROXY_TARGET=https://movie-trail-py.vercel.app

# Optional direct API access for catalogue testing.
# Session authentication across unrelated Vercel domains requires the same-origin proxy.
# VITE_API_BASE_URL=http://localhost:8000/api/v1/
# VITE_API_BASE_URL=https://movie-trail-py.vercel.app/api/v1/
# Backend API documentation: https://movie-trail-py.vercel.app/api/docs
